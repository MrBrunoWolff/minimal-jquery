{
  "name": "@mrbrunowolff/minimal-jquery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/minimal-jquery.git"
  },
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Minimal jQuery 4.0 starter-kit with Bun, TypeScript, and JSX support",
  "type": "module",
  "bin": {
    "create": "bin/create-jquery-app.js"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build ./public/index.html --outdir=dist --minify",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "audit": "bun audit --audit-level=high",
    "check:ci": "node scripts/quality.mjs",
    "check:code": "node scripts/quality.mjs code",
    "check:security": "node scripts/quality.mjs security"
  },
  "keywords": [
    "jquery",
    "bun",
    "typescript",
    "jsx",
    "starter",
    "template",
    "minimal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jquery": "latest"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "latest",
    "@types/bun": "latest",
    "@types/jquery": "latest"
  },
  "files": [
    "bin",
    "src",
    "public",
    "tests",
    "server.ts",
    "happydom.ts",
    "bunfig.toml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.2"
}
