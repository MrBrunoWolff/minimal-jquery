{
  "name": "minimal-jquery",
  "version": "1.0.0",
  "description": "Minimal jQuery 4.0 starter-kit with Bun, TypeScript, and JSX support",
  "type": "module",
  "bin": {
    "create": "bin/create-jquery-app.js"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build ./public/index.html --outdir=dist --minify",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "audit": "bun audit --audit-level=high"
  },
  "keywords": [
    "jquery",
    "bun",
    "typescript",
    "jsx",
    "starter",
    "template",
    "minimal"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jquery": "^4.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "1.3.14",
    "@types/jquery": "^4.0.1"
  },
  "files": [
    "bin",
    "src",
    "public",
    "tests",
    "server.ts",
    "happydom.ts",
    "bunfig.toml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.0"
}
